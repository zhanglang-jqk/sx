<!--
  智能镜 · 试妆造型 (1280×800)
  还原自 apps-v1.html 试妆造型页
-->
<screen>
  <styles>
    <style name="style_iconbtn" bg_color="#card_top" bg_opa="180" border_color="#glass_brd" border_width="1" radius="12" pad_all="9" />
    <style name="style_makeup_preview" bg_color="#card_top" bg_opa="200" border_color="#glass_brd" border_width="1" radius="20" />
    <style name="style_btn_primary" bg_color="0xF2A5BD" bg_grad_color="#lilac" bg_grad_dir="hor" radius="14" pad_ver="12" />
    <style name="style_btn_ghost" bg_color="0xFFFFFF" bg_opa="40" border_color="0xFFFFFF" border_opa="30" border_width="1" radius="14" pad_ver="12" />
    <style name="style_mtab" bg_color="#card_top" bg_opa="180" border_color="#glass_brd" border_width="1" radius="12" pad_ver="9" />
    <style name="style_mtab_active" bg_color="0xF2A5BD" bg_grad_color="#lilac" bg_grad_dir="hor" radius="12" pad_ver="9" />
    <style name="style_tpl" bg_color="#card_top" bg_opa="200" border_color="#glass_brd" border_width="1" radius="15" />
    <style name="style_tpl_active" bg_color="#card_top" bg_opa="200" border_color="0xF2A5BD" border_width="2" radius="15" />
  </styles>

  <view flex_flow="column" style_bg_color="#bg" width="100%" height="100%">

    <!-- ================= AppBar ================= -->
    <lv_obj flex_flow="row" width="100%" height="70"
            style_flex_cross_place="center" style_pad_column="14"
            style_pad_hor="28" style_pad_top="16">
      <lv_obj width="40" height="40" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
        <style name="style_iconbtn"/>
        <lv_label text="‹" style_text_color="#ink" style_text_font="#font_lg" />
      </lv_obj>
      <lv_obj flex_flow="column" height="content" style_flex_grow="1">
        <lv_label text="试妆造型" style_text_color="#ink" style_text_font="#font_lg" />
        <lv_label text="拍照 · AI 云端合成" style_text_color="#ink3" style_text_font="#font_sm" style_pad_top="3" />
      </lv_obj>
      <lv_obj width="40" height="40" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
        <style name="style_iconbtn"/>
        <lv_label text="⚙" style_text_color="#ink2" style_text_font="#font_lg" />
      </lv_obj>
    </lv_obj>

    <!-- ================= 主体：左预览 + 右模板 ================= -->
    <lv_obj flex_flow="row" width="100%" height="content"
            style_flex_cross_place="start" style_pad_column="22"
            style_pad_hor="28" style_pad_top="8" style_pad_bottom="24">

      <!-- ===== 左：面部预览 ===== -->
      <lv_obj flex_flow="column" width="48%" height="content" style_flex_grow="1" style_pad_row="12">
        <!-- 预览面板 -->
        <lv_obj width="100%" height="420" flex_flow="column"
                style_flex_main_place="center" style_flex_cross_place="center" style_pad_row="14">
          <style name="style_makeup_preview"/>
          <!-- 脸部示意 -->
          <lv_obj width="150" height="150" style_radius="999" style_bg_color="0xFFFFFF" style_bg_opa="50"
                  style_border_width="2" style_border_color="0x8A90A0"
                  flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_column="20">
            <lv_obj width="10" height="10" style_radius="999" style_bg_color="#lilac" />
            <lv_obj width="10" height="10" style_radius="999" style_bg_color="#lilac" />
          </lv_obj>
          <lv_label text="点「拍摄」上传照片" style_text_color="#ink3" style_text_font="#font_sm" style_pad_top="20" />
        </lv_obj>

        <!-- 操作按钮 -->
        <lv_obj flex_flow="row" width="100%" height="content" style_pad_column="10">
          <lv_obj flex_flow="row" width="content" height="content" style_flex_grow="1" style_flex_main_place="center">
            <style name="style_btn_ghost"/>
            <lv_label text="拍摄" style_text_color="#ink2" style_text_font="#font_md" />
          </lv_obj>
          <lv_obj flex_flow="row" width="content" height="content" style_flex_grow="1" style_flex_main_place="center">
            <style name="style_btn_primary"/>
            <lv_label text="生成效果" style_text_color="0x0A0D12" style_text_font="#font_md" />
          </lv_obj>
        </lv_obj>
      </lv_obj>

      <!-- ===== 右：模板选择 ===== -->
      <lv_obj flex_flow="column" width="52%" height="content" style_flex_grow="1">

        <!-- 模式 Tab -->
        <lv_obj flex_flow="row" width="100%" height="content" style_pad_column="8" style_pad_bottom="14">
          <lv_obj flex_flow="row" width="content" height="content" style_flex_grow="1" style_flex_main_place="center"><style name="style_mtab_active"/><lv_label text="仿妆" style_text_color="0x0A0D12" style_text_font="#font_sm" /></lv_obj>
          <lv_obj flex_flow="row" width="content" height="content" style_flex_grow="1" style_flex_main_place="center"><style name="style_mtab"/><lv_label text="发型" style_text_color="#ink2" style_text_font="#font_sm" /></lv_obj>
        </lv_obj>

        <!-- 模板网格（3 列 × 2 行） -->
        <lv_obj flex_flow="row_wrap" width="100%" height="content" style_pad_column="11" style_pad_row="11">
          <lv_obj width="content" height="content" flex_flow="column" style_flex_grow="1">
            <style name="style_tpl_active"/>
            <lv_obj width="100%" height="74" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
              <lv_label text="◉" style_text_color="0xF2A5BD" style_text_font="#font_xl" />
            </lv_obj>
            <lv_label text="自然妆" style_text_color="0xF2A5BD" style_text_font="#font_sm" align="center" style_pad_ver="8" />
          </lv_obj>
          <lv_obj width="content" height="content" flex_flow="column" style_flex_grow="1">
            <style name="style_tpl"/>
            <lv_obj width="100%" height="74" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
              <lv_label text="◉" style_text_color="#rose" style_text_font="#font_xl" />
            </lv_obj>
            <lv_label text="通勤妆" style_text_color="#ink2" style_text_font="#font_sm" align="center" style_pad_ver="8" />
          </lv_obj>
          <lv_obj width="content" height="content" flex_flow="column" style_flex_grow="1">
            <style name="style_tpl"/>
            <lv_obj width="100%" height="74" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
              <lv_label text="◉" style_text_color="0xEF6A5E" style_text_font="#font_xl" />
            </lv_obj>
            <lv_label text="约会妆" style_text_color="#ink2" style_text_font="#font_sm" align="center" style_pad_ver="8" />
          </lv_obj>
          <lv_obj width="content" height="content" flex_flow="column" style_flex_grow="1">
            <style name="style_tpl"/>
            <lv_obj width="100%" height="74" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
              <lv_label text="◉" style_text_color="#lilac" style_text_font="#font_xl" />
            </lv_obj>
            <lv_label text="晚宴妆" style_text_color="#ink2" style_text_font="#font_sm" align="center" style_pad_ver="8" />
          </lv_obj>
          <lv_obj width="content" height="content" flex_flow="column" style_flex_grow="1">
            <style name="style_tpl"/>
            <lv_obj width="100%" height="74" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
              <lv_label text="◉" style_text_color="#blue" style_text_font="#font_xl" />
            </lv_obj>
            <lv_label text="欧美妆" style_text_color="#ink2" style_text_font="#font_sm" align="center" style_pad_ver="8" />
          </lv_obj>
          <lv_obj width="content" height="content" flex_flow="column" style_flex_grow="1">
            <style name="style_tpl"/>
            <lv_obj width="100%" height="74" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
              <lv_label text="◉" style_text_color="#aqua" style_text_font="#font_xl" />
            </lv_obj>
            <lv_label text="日系妆" style_text_color="#ink2" style_text_font="#font_sm" align="center" style_pad_ver="8" />
          </lv_obj>
        </lv_obj>

      </lv_obj>

    </lv_obj>

  </view>
</screen>
