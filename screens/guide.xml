<!--
  智能镜 · 化妆指导 (1280×800)
  还原自 apps-v1.html 化妆指导页
-->
<screen>
  <styles>
    <style name="style_iconbtn" bg_color="#card_top" bg_opa="180" border_color="#glass_brd" border_width="1" radius="12" pad_all="9" />
    <style name="style_guide_left" bg_color="#card_top" bg_opa="200" border_color="#glass_brd" border_width="1" radius="20" />
    <style name="style_toolchip" bg_color="#card_top" bg_opa="180" border_color="#glass_brd" border_width="1" radius="16" pad_hor="14" pad_ver="6" />
    <style name="style_toolchip_active" bg_color="0xF2A5BD" bg_grad_color="#lilac" bg_grad_dir="hor" radius="16" pad_hor="14" pad_ver="6" />
    <style name="style_stepnum" bg_color="0xF2A5BD" bg_grad_color="#lilac" bg_grad_dir="hor" radius="16" pad_all="10" />
    <style name="style_step_tips" bg_color="0xFFFFFF" bg_opa="40" border_color="0xFFFFFF" border_opa="30" border_width="1" radius="16" pad_hor="18" pad_ver="16" />
    <style name="style_btn_primary" bg_color="0xF2A5BD" bg_grad_color="#lilac" bg_grad_dir="hor" radius="14" pad_ver="12" />
    <style name="style_btn_ghost" bg_color="0xFFFFFF" bg_opa="40" border_color="0xFFFFFF" border_opa="30" border_width="1" radius="14" pad_ver="12" />
  </styles>

  <view flex_flow="column" style_bg_color="#bg" width="100%" height="100%">

    <!-- ================= AppBar ================= -->
    <lv_obj flex_flow="row" width="100%" height="70"
            style_flex_cross_place="center" style_pad_column="14"
            style_pad_hor="28" style_pad_top="16">
      <lv_obj width="40" height="40" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
        <style name="style_iconbtn"/>
        <lv_label text="‹" style_text_color="#ink" style_text_font="#font_lg" />
      </lv_obj>
      <lv_obj flex_flow="column" height="content" style_flex_grow="1">
        <lv_label text="化妆指导" style_text_color="#ink" style_text_font="#font_lg" />
        <lv_label text="AI 实时妆容指导" style_text_color="#ink3" style_text_font="#font_sm" style_pad_top="3" />
      </lv_obj>
      <lv_obj width="40" height="40" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
        <style name="style_iconbtn"/>
        <lv_label text="⚙" style_text_color="#ink2" style_text_font="#font_lg" />
      </lv_obj>
    </lv_obj>

    <!-- ================= 主体：左预览 + 右步骤 ================= -->
    <lv_obj flex_flow="row" width="100%" height="content"
            style_flex_cross_place="start" style_pad_column="22"
            style_pad_hor="28" style_pad_top="8" style_pad_bottom="24">

      <!-- ===== 左：实时检测 ===== -->
      <lv_obj width="50%" height="560" flex_flow="column"
              style_flex_main_place="center" style_flex_cross_place="center" style_pad_row="16">
        <style name="style_guide_left"/>

        <!-- LIVE 标签 -->
        <lv_obj flex_flow="row" width="content" height="content" style_flex_cross_place="center" style_pad_column="6"
                style_bg_color="0x000000" style_bg_opa="90" style_radius="14" style_pad_hor="11" style_pad_ver="4"
                style_margin_right="auto" style_margin_left="24" style_margin_top="16">
          <lv_obj width="7" height="7" style_radius="999" style_bg_color="#green" />
          <lv_label text=" LIVE · 实时检测" style_text_color="#up" style_text_font="#font_sm" />
        </lv_obj>

        <!-- 脸部 + 区域框 -->
        <lv_obj width="150" height="150" style_radius="999" style_bg_color="0xFFFFFF" style_bg_opa="50"
                style_border_width="2" style_border_color="0x8A90A0"
                flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_column="20">
          <lv_obj width="10" height="10" style_radius="999" style_bg_color="#lilac" />
          <lv_obj width="10" height="10" style_radius="999" style_bg_color="#lilac" />
        </lv_obj>
        <!-- 眼影区域虚线框 -->
        <lv_obj width="140" height="46" style_border_width="2" style_border_color="0xF2A5BD" style_border_opa="200" style_radius="999" />

      </lv_obj>

      <!-- ===== 右：步骤 ===== -->
      <lv_obj flex_flow="column" width="50%" height="content" style_flex_grow="1">

        <!-- 妆容 chip -->
        <lv_obj flex_flow="row" width="100%" height="content" style_pad_column="8" style_pad_bottom="14">
          <lv_obj width="content" height="content"><style name="style_toolchip_active"/><lv_label text="日常妆" style_text_color="0x0A0D12" style_text_font="#font_sm" /></lv_obj>
          <lv_obj width="content" height="content"><style name="style_toolchip"/><lv_label text="通勤妆" style_text_color="#ink2" style_text_font="#font_sm" /></lv_obj>
          <lv_obj width="content" height="content"><style name="style_toolchip"/><lv_label text="约会妆" style_text_color="#ink2" style_text_font="#font_sm" /></lv_obj>
          <lv_obj width="content" height="content"><style name="style_toolchip"/><lv_label text="晚宴妆" style_text_color="#ink2" style_text_font="#font_sm" /></lv_obj>
        </lv_obj>

        <!-- 步骤标题 -->
        <lv_obj flex_flow="row" width="100%" height="content" style_flex_cross_place="center" style_pad_column="14" style_pad_bottom="16">
          <lv_obj width="52" height="52" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center">
            <style name="style_stepnum"/>
            <lv_label text="3" style_text_color="0xFFFFFF" style_text_font="#font_num_xl" />
            <lv_label text="/ 8" style_text_color="0xFFFFFF" style_text_font="#font_sm" style_bg_opa="200" />
          </lv_obj>
          <lv_obj flex_flow="column" height="content">
            <lv_label text="眼影晕染" style_text_color="#ink" style_text_font="#font_lg" />
            <lv_label text="眼部区域 · 上眼睑" style_text_color="#ink3" style_text_font="#font_sm" style_pad_top="3" />
          </lv_obj>
        </lv_obj>

        <!-- 进度条 -->
        <lv_obj flex_flow="column" width="100%" height="content" style_pad_bottom="16">
          <lv_obj width="100%" height="6" style_radius="3" style_bg_color="0xFFFFFF" style_bg_opa="40">
            <lv_obj width="37%" height="100%" style_radius="3" style_bg_color="0xF2A5BD" style_bg_grad_color="#lilac" style_bg_grad_dir="hor" />
          </lv_obj>
          <lv_obj flex_flow="row" width="100%" style_flex_main_place="space_between" style_pad_top="6">
            <lv_label text="第 3 步 · 眼妆" style_text_color="#ink3" style_text_font="#font_sm" />
            <lv_label text="37%" style_text_color="#ink3" style_text_font="#font_sm" />
          </lv_obj>
        </lv_obj>

        <!-- 小美指导 -->
        <lv_obj width="100%" height="content">
          <style name="style_step_tips"/>
          <lv_label text="小美指导：用眼影刷取少量眼影，从睫毛根部向上晕染。" style_text_color="#ink" style_text_font="#font_md" />
          <lv_label text="· 颜色从眼尾向眼头由深到浅" style_text_color="#ink2" style_text_font="#font_sm" style_pad_top="8" />
          <lv_label text="· 手法轻扫，避免色块堆积" style_text_color="#ink2" style_text_font="#font_sm" style_pad_top="4" />
          <lv_label text="· 已完成程度不错，继续！" style_text_color="#ink2" style_text_font="#font_sm" style_pad_top="4" />
        </lv_obj>

        <!-- 控制按钮 -->
        <lv_obj flex_flow="row" width="100%" height="content" style_pad_column="10" style_pad_top="16">
          <lv_obj flex_flow="row" width="content" height="content" style_flex_grow="1" style_flex_main_place="center">
            <style name="style_btn_ghost"/>
            <lv_label text="← 上一步" style_text_color="#ink2" style_text_font="#font_md" />
          </lv_obj>
          <lv_obj flex_flow="row" width="content" height="content" style_flex_grow="1" style_flex_main_place="center">
            <style name="style_btn_primary"/>
            <lv_label text="下一步 →" style_text_color="0x0A0D12" style_text_font="#font_md" />
          </lv_obj>
        </lv_obj>

      </lv_obj>

    </lv_obj>

  </view>
</screen>
